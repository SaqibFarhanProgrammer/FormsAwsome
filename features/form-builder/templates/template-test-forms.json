{
  "default_contact_form": {
    "id": "test-default-contact-form",
    "type": "default_contact_form",
    "templateType": "default_contact_form",
    "title": "Contact Form Template",
    "description": "A simple form for general questions and contact requests.",
    "fields": [
      {
        "id": "name",
        "type": "text",
        "label": "Full name",
        "placeholder": "Your name",
        "validation": { "required": true }
      },
      {
        "id": "email",
        "type": "email",
        "label": "Email address",
        "placeholder": "you@example.com",
        "validation": { "required": true }
      },
      {
        "id": "message",
        "type": "textarea",
        "label": "Your message",
        "placeholder": "How can we help?",
        "validation": { "required": true, "min": 10 }
      }
    ],
    "settings": {
      "submitButtonText": "Submit",
      "successMessage": "Thanks for contacting us!",
      "redirectUrl": null,
      "notifyEmail": null
    }
  },
